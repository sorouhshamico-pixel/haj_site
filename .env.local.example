# Copy this file to .env.local for local development, and add the same values
# as Environment Variables in your Vercel project settings for production.
# Full setup instructions: docs/ADMIN-SETUP.md

# Neon Postgres connection string (Vercel: Storage tab -> Create Database -> Neon)
DATABASE_URL=

# A long random string used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The username you'll type on the /admin/login screen.
ADMIN_USERNAME=

# A bcrypt hash of your chosen admin password — never put the raw password here.
# Generate it with: npm run hash-password "YourChosenPassword"
ADMIN_PASSWORD_HASH=
